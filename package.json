{
  "name": "toddspect",
  "version": "0.1.0",
  "private": true,
  "description": "ToddSpect — Meta-Agent Orchestrator for VSCode",
  "workspaces": [
    "packages/extension",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:cli": "npm run build -w packages/cli",
    "build:extension": "npm run build -w packages/extension",
    "bundle:cli": "node scripts/bundle-cli.mjs",
    "package:vsix": "npm run build:cli && npm run bundle:cli && npm run build:prod -w packages/extension && npm run package -w packages/extension",
    "package:vsix:release": "node scripts/package-vsix-release.mjs",
    "getGoat": "npm run build:cli && node packages/cli/dist/index.js check getGoat",
    "setup": "npm run build:cli && node packages/cli/dist/index.js setup",
    "watch": "npm run watch --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules",
    "audit:ci": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "tar": "7.5.19",
    "undici": "6.27.0",
    "form-data": "4.0.6",
    "hono": "4.12.27",
    "markdown-it": "14.3.0",
    "linkify-it": "5.0.2",
    "js-yaml": "4.3.0",
    "esbuild": "0.28.1",
    "@tootallnate/once": "2.0.1",
    "@connectrpc/connect-node": {
      "undici": "6.27.0"
    },
    "http-proxy-agent": {
      "@tootallnate/once": "2.0.1"
    },
    "make-fetch-happen": {
      "cacache": {
        "tar": "7.5.19"
      },
      "http-proxy-agent": {
        "@tootallnate/once": "2.0.1"
      }
    },
    "cacache": {
      "tar": "7.5.19"
    },
    "node-gyp": {
      "tar": "7.5.19",
      "make-fetch-happen": {
        "cacache": {
          "tar": "7.5.19"
        },
        "http-proxy-agent": {
          "@tootallnate/once": "2.0.1"
        }
      }
    },
    "sqlite3": {
      "tar": "7.5.19",
      "node-gyp": {
        "tar": "7.5.19"
      }
    },
    "tsup": {
      "esbuild": "0.28.1"
    }
  }
}
