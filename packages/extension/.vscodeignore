# Files excluded from the .vsix package

# Source (bundled by esbuild into dist/)
src/**
**/*.ts
!**/*.d.ts

# Config files
tsconfig*.json
esbuild.mjs
.vscode/**

# Tests
test/**
**/*.test.*
**/*.spec.*

# Dev artifacts
node_modules/**
# Ship Cursor SDK next to bundled CLI (see scripts/bundle-cli.mjs)
!cli/node_modules/**
!cli/node_modules/@cursor/**
!cli/node_modules/@bufbuild/**
!cli/node_modules/@connectrpc/**
!cli/node_modules/sqlite3/**
!cli/node_modules/zod/**
.eslintrc*
.prettierrc*
*.log
*.map

# Keep in package:
# dist/extension.js       ✓ extension host bundle
# dist/webview/**         ✓ webview bundles
# cli/dist/index.js       ✓ bundled Todd CLI (orchestrator daemon)
# resources/**            ✓ icons
# package.json            ✓ manifest
# README.md               ✓ marketplace page
# CHANGELOG.md            ✓ release notes
# LICENSE                 ✓ license
