{
  "name": "harness-vscode",
  "displayName": "Harness of AI — Meta-Agent Orchestrator",
  "description": "One VS Code sidebar for Copilot, Claude, Cursor, Devin, and Kiro — with Spec-Driven Development and shared file context. No IDE switching per provider.",
  "version": "0.1.6",
  "private": true,
  "publisher": "harness-ai",
  "license": "MIT",
  "icon": "resources/harness-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nbsjunior/harness"
  },
  "bugs": {
    "url": "https://github.com/nbsjunior/harness/issues"
  },
  "homepage": "https://github.com/nbsjunior/harness#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "cursor",
    "claude",
    "mcp",
    "orchestrator",
    "spec-driven"
  ],
  "activationEvents": [
    "onView:harness.chatView",
    "onView:harness.specView",
    "onCommand:harness.runAgent",
    "onCommand:harness.initWorkspace",
    "onCommand:harness.openConfig"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harness-sidebar",
          "title": "Harness of AI",
          "icon": "resources/harness.svg"
        }
      ]
    },
    "views": {
      "harness-sidebar": [
        {
          "type": "webview",
          "id": "harness.chatView",
          "name": "Chat",
          "contextualTitle": "Harness of AI Chat"
        },
        {
          "type": "webview",
          "id": "harness.liveEditsView",
          "name": "Live Edits",
          "contextualTitle": "Harness Live Edits"
        },
        {
          "type": "webview",
          "id": "harness.specView",
          "name": "Spec Manager",
          "contextualTitle": "Harness of AI Spec Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "harness.addToContext",
        "title": "Add to Harness of AI Context",
        "category": "Harness of AI",
        "icon": "$(add)"
      },
      {
        "command": "harness.removeFromContext",
        "title": "Remove from Harness of AI Context",
        "category": "Harness of AI",
        "icon": "$(remove)"
      },
      {
        "command": "harness.runAgent",
        "title": "Run Agent",
        "category": "Harness of AI",
        "icon": "$(play)"
      },
      {
        "command": "harness.openConfig",
        "title": "Open Configuration",
        "category": "Harness of AI",
        "icon": "$(settings-gear)"
      },
      {
        "command": "harness.openUserManual",
        "title": "Open User Manual",
        "category": "Harness of AI",
        "icon": "$(book)"
      },
      {
        "command": "harness.initWorkspace",
        "title": "Initialize Workspace",
        "category": "Harness of AI",
        "icon": "$(new-folder)"
      },
      {
        "command": "harness.newSpec",
        "title": "New Spec / Skill",
        "category": "Harness of AI",
        "icon": "$(file-add)"
      },
      {
        "command": "harness.clearContext",
        "title": "Clear Chat & Context",
        "category": "Harness of AI",
        "icon": "$(clear-all)"
      },
      {
        "command": "harness.revertAgentChanges",
        "title": "Revert Agent File Changes",
        "category": "Harness of AI",
        "icon": "$(discard)"
      },
      {
        "command": "harness.liveEdits.focus",
        "title": "Focus Live Edits Panel",
        "category": "Harness of AI",
        "icon": "$(diff)"
      },
      {
        "command": "harness.showContext",
        "title": "Show Current Context",
        "category": "Harness of AI"
      },
      {
        "command": "harness.check.getGoat",
        "title": "Check getGoat",
        "category": "Harness of AI",
        "icon": "$(pulse)"
      },
      {
        "command": "harness.copilotLogin",
        "title": "Login: GitHub Copilot",
        "category": "Harness of AI",
        "icon": "$(account)"
      },
      {
        "command": "harness.aidlcInstall",
        "title": "Install AI-DLC Workflow (Kiro)",
        "category": "Harness of AI",
        "icon": "$(cloud-download)"
      },
      {
        "command": "harness.setup",
        "title": "Run Setup (Kiro CLI + AI-DLC)",
        "category": "Harness of AI",
        "icon": "$(rocket)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "harness.addToContext",
          "when": "explorerResourceIsFolder || resourceLangId",
          "group": "2_workspace@99"
        }
      ],
      "editor/context": [
        {
          "command": "harness.addToContext",
          "group": "harness@1"
        }
      ],
      "editor/title": [
        {
          "command": "harness.addToContext",
          "group": "navigation",
          "when": "resourceLangId"
        }
      ],
      "view/title": [
        {
          "command": "harness.openConfig",
          "when": "view == harness.chatView",
          "group": "navigation"
        },
        {
          "command": "harness.openUserManual",
          "when": "view == harness.chatView",
          "group": "navigation"
        },
        {
          "command": "harness.clearContext",
          "when": "view == harness.chatView",
          "group": "navigation"
        },
        {
          "command": "harness.newSpec",
          "when": "view == harness.specView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "harness.addToContext",
          "when": "explorerResourceIsFolder || resourceLangId"
        },
        {
          "command": "harness.removeFromContext"
        },
        {
          "command": "harness.runAgent"
        },
        {
          "command": "harness.openConfig"
        },
        {
          "command": "harness.openUserManual"
        },
        {
          "command": "harness.initWorkspace"
        },
        {
          "command": "harness.newSpec"
        },
        {
          "command": "harness.clearContext"
        },
        {
          "command": "harness.showContext"
        },
        {
          "command": "harness.check.getGoat"
        },
        {
          "command": "harness.aidlcInstall"
        },
        {
          "command": "harness.setup"
        }
      ]
    },
    "configuration": {
      "title": "Harness of AI",
      "properties": {
        "harness.defaultWorkspace": {
          "type": "string",
          "default": "",
          "description": "Override workspace root for Harness of AI CLI and context (absolute path). Empty = use the opened VS Code workspace folder.",
          "scope": "resource"
        },
        "harness.specsDirectory": {
          "type": "string",
          "default": ".harness/specs",
          "description": "Directory (relative to workspace root) where Spec-Driven Development YAML/Markdown files are stored.",
          "scope": "resource"
        },
        "harness.promptOptimization.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Inject provider-agnostic efficiency guidance and trim context/history to save tokens.",
          "scope": "resource"
        },
        "harness.promptOptimization.maxContextCharsPerFile": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Max characters per context file sent to agents (truncates with a notice).",
          "scope": "resource"
        },
        "harness.promptOptimization.maxHistoryMessages": {
          "type": "number",
          "default": 24,
          "minimum": 4,
          "maximum": 200,
          "description": "Max non-system chat messages kept in the prompt (recent turns only).",
          "scope": "resource"
        },
        "harness.context.includeOpenEditors": {
          "type": "boolean",
          "default": true,
          "description": "Automatically attach visible editor files to each chat message (in addition to manual context chips).",
          "scope": "resource"
        },
        "harness.context.includeWorkspaceRoot": {
          "type": "boolean",
          "default": true,
          "description": "Automatically include the workspace folder in context so agents can see the project (scanned as text files, same limits as manual folder context).",
          "scope": "resource"
        },
        "harness.contextDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories to include in agent context by default.",
          "scope": "resource"
        },
        "harness.defaultAgent": {
          "type": "string",
          "enum": [
            "auto",
            "copilot",
            "devin",
            "cursor",
            "claude",
            "kiro"
          ],
          "default": "auto",
          "description": "Default provider in chat (auto = Harness of AI picks the best agent per message).",
          "scope": "resource"
        },
        "harness.agent.showLiveDiff": {
          "type": "boolean",
          "default": true,
          "description": "Open a side-by-side diff when the agent writes a file in Agent / Spec+Agent mode.",
          "scope": "resource"
        },
        "harness.agent.openChangedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Open files in the editor when the agent modifies them.",
          "scope": "resource"
        },
        "harness.agent.mirrorCommandsToTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Mirror git/gh tool commands to the integrated Harness terminal.",
          "scope": "resource"
        },
        "harness.cursor.agentExecution": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "cloud"
          ],
          "default": "auto",
          "description": "Cursor + Agent mode: auto = local file edits via Cursor SDK when API key is set (no Copilot); cloud = remote Cursor Cloud only (no local file changes).",
          "scope": "resource"
        },
        "harness.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Harness of AI CLI binary. Leave empty to use the bundled CLI.",
          "scope": "machine"
        },
        "harness.connectors.copilot.token": {
          "type": "string",
          "default": "",
          "description": "GitHub personal access token for Copilot API access.",
          "scope": "machine"
        },
        "harness.connectors.copilot.endpoint": {
          "type": "string",
          "default": "https://api.githubcopilot.com",
          "description": "GitHub Copilot API endpoint.",
          "scope": "machine"
        },
        "harness.connectors.devin.apiKey": {
          "type": "string",
          "default": "",
          "description": "Devin API key.",
          "scope": "machine"
        },
        "harness.connectors.devin.endpoint": {
          "type": "string",
          "default": "https://api.devin.ai/v1",
          "description": "Devin API endpoint.",
          "scope": "machine"
        },
        "harness.connectors.cursor.endpoint": {
          "type": "string",
          "default": "https://api.cursor.com",
          "description": "Cursor Cloud Agents API base URL (https://api.cursor.com). Do not use api2.cursor.sh.",
          "scope": "machine"
        },
        "harness.connectors.cursor.apiKey": {
          "type": "string",
          "default": "",
          "description": "Cursor AI API key.",
          "scope": "machine"
        },
        "harness.connectors.claude.path": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude Code CLI binary (e.g. 'claude' if on PATH).",
          "scope": "machine"
        },
        "harness.connectors.claude.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key for Claude (used when not relying on Claude Code CLI auth).",
          "scope": "machine"
        },
        "harness.connectors.kiro.cliPath": {
          "type": "string",
          "default": "kiro-cli",
          "description": "Path to the Kiro CLI binary (AI-DLC via steering files).",
          "scope": "machine"
        },
        "harness.connectors.kiro.apiKey": {
          "type": "string",
          "default": "",
          "description": "Kiro Pro API key (KIRO_API_KEY) for headless CLI mode.",
          "scope": "machine"
        },
        "harness.connectors.kiro.trustTools": {
          "type": "string",
          "default": "read,grep,write",
          "description": "Tool categories auto-approved for kiro-cli (--trust-tools).",
          "scope": "machine"
        },
        "harness.connectors.kiro.trustAllTools": {
          "type": "boolean",
          "default": false,
          "description": "Pass --trust-all-tools to kiro-cli (use with caution).",
          "scope": "machine"
        },
        "harness.connectors.kiro.mode": {
          "type": "string",
          "enum": ["cli", "rest"],
          "default": "cli",
          "description": "Kiro connector mode: cli (AI-DLC steering) or legacy rest.",
          "scope": "machine"
        },
        "harness.connectors.kiro.endpoint": {
          "type": "string",
          "default": "",
          "description": "Legacy REST endpoint (only when harness.connectors.kiro.mode is rest).",
          "scope": "machine"
        },
        "harness.aidlc.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "Auto-install AI-DLC rules into .kiro/steering before Kiro chat.",
          "scope": "resource"
        },
        "harness.apiServers": {
          "type": "array",
          "default": [],
          "description": "Additional OpenAI-compatible API servers (custom providers).",
          "scope": "resource",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "baseUrl": { "type": "string" },
              "apiKey": { "type": "string" },
              "model": { "type": "string" }
            },
            "required": ["id", "name", "baseUrl"]
          }
        },
        "harness.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable MCP (Model Context Protocol) client for connecting to external MCP servers.",
          "scope": "resource"
        },
        "harness.mcp.servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "transport"
            ]
          },
          "default": [],
          "description": "List of MCP servers to connect to.",
          "scope": "resource"
        },
        "harness.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous usage telemetry to help improve Harness of AI.",
          "scope": "machine"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "harness.gettingStarted",
        "title": "Getting Started with Harness of AI",
        "description": "Set up your AI agent orchestrator in minutes.",
        "steps": [
          {
            "id": "harness.gettingStarted.init",
            "title": "Initialize your workspace",
            "description": "Run **Harness of AI: Initialize Workspace** to create the `.harness/` directory with example specs.\n[Initialize Workspace](command:harness.initWorkspace)",
            "completionEvents": [
              "onCommand:harness.initWorkspace"
            ]
          },
          {
            "id": "harness.gettingStarted.configure",
            "title": "Configure agent connectors",
            "description": "Add your API keys in Harness of AI settings.\n[Open Configuration](command:harness.openConfig)",
            "completionEvents": [
              "onCommand:harness.openConfig"
            ]
          },
          {
            "id": "harness.gettingStarted.chat",
            "title": "Start chatting with your agent",
            "description": "Click the Harness of AI icon in the Activity Bar and start a conversation.",
            "completionEvents": [
              "onView:harness.chatView"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build:prod": "node esbuild.mjs --production",
    "clean": "rimraf dist",
    "bundle:cli": "node ../../scripts/bundle-cli.mjs",
    "vscode:prepublish": "npm run build:prod && npm run bundle:cli",
    "package": "npm run bundle:cli && vsce package --no-dependencies",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.2",
    "@types/marked": "^5.0.2",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "execa": "^9.5.2",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.17",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
